[
 {
  "name": "basic",
  "content": {
   "subject": "Hi {{ first_name|default('there') }}",
   "preheader": "Pre {{ first_name }}",
   "blocks": [
    {
     "type": "heading",
     "text": "Hello {{ first_name|default('there') }}",
     "level": 1,
     "align": "center"
    },
    {
     "type": "text",
     "html": "<p>Plain <strong>text</strong> with a <a href=\"https://shop.test/a?x=1&y=2\">link</a> and {{ person.properties.city|default('your city') }}.</p>",
     "align": "left"
    },
    {
     "type": "button",
     "text": "Shop now",
     "href": "https://shop.test/sale",
     "color": "#ff0000",
     "align": "center"
    },
    {
     "type": "button",
     "text": "Personal",
     "href": "{{ person.properties.url|default('https://shop.test/me') }}"
    },
    {
     "type": "image",
     "src": "https://cdn.test/hero.png",
     "alt": "Hero",
     "href": "https://shop.test",
     "width": 400
    },
    {
     "type": "image",
     "src": "https://cdn.test/plain.png",
     "alt": ""
    },
    {
     "type": "divider"
    },
    {
     "type": "spacer",
     "height": 40
    },
    {
     "type": "product",
     "title": "Tote",
     "price": "$48",
     "image": "https://cdn.test/tote.png",
     "href": "https://shop.test/tote",
     "button_text": "Buy"
    },
    {
     "type": "html",
     "html": "<table><tr><td>raw {{ organization.name }}</td></tr></table>"
    },
    {
     "type": "unknown_type",
     "text": "ignored"
    },
    {
     "type": "if_open",
     "expr": "true"
    },
    {
     "type": "text",
     "html": "<p>after a marker</p>"
    },
    {
     "type": "if_close"
    }
   ]
  }
 },
