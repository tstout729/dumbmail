# Where people reach this server (tracking links, unsubscribe links and forms use it).
PUBLIC_URL=https://marketing.example.com
# Generate with: openssl rand -base64 48
SECRET_KEY=
# Secret path segment for provider webhooks: {PUBLIC_URL}/webhooks/{ses|telnyx|twilio}/{WEBHOOK_SECRET}
WEBHOOK_SECRET=
SECURE_COOKIES=true
# Turn off after creating your own account if the server is public.
ALLOW_SIGNUP=true

# Email: `ses` (Amazon SES, $0.10 per 1,000 emails) or `log` (prints instead of sending).
EMAIL_PROVIDER=log
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Configuration set that publishes Bounce, Complaint and Delivery events to an SNS topic
# subscribed to {PUBLIC_URL}/webhooks/ses/{WEBHOOK_SECRET}
SES_CONFIGURATION_SET=
SEND_RATE_PER_SEC=14

# SMS: `telnyx`, `twilio` or `log`.
SMS_PROVIDER=log
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Hosted service only: enforce plan limits.
HOSTED=false
