# Where people reach this server (tracking links, unsubscribe links and forms use it).
PUBLIC_URL=https://marketing.example.com
# Generate with: openssl rand -base64 48
SECRET_KEY=
# Secret path segment for provider webhooks: {PUBLIC_URL}/webhooks/{ses|telnyx|twilio}/{WEBHOOK_SECRET}
WEBHOOK_SECRET=
SECURE_COOKIES=true
# Turn off after creating your own account if the server is public.
ALLOW_SIGNUP=true

# Email: `ses` (Amazon SES, $0.10 per 1,000 emails) or `log` (prints instead of sending).
EMAIL_PROVIDER=log
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Configuration set that publishes Bounce, Complaint and Delivery events to an SNS topic
# subscribed to {PUBLIC_URL}/webhooks/ses/{WEBHOOK_SECRET}
SES_CONFIGURATION_SET=
SEND_RATE_PER_SEC=14

# SMS: `telnyx`, `twilio` or `log`.
SMS_PROVIDER=log
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Hosted service only: enforce plan limits.
HOSTED=false

# "Continue with Google" (optional). Create an OAuth web client whose authorized redirect URI is
# PUBLIC_URL (or GOOGLE_REDIRECT_BASE) + /api/auth/google/callback. Leave unset to hide the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Contact address shown on /about, /privacy and /terms.
# SUPPORT_EMAIL=support@example.com
# Google Search Console HTML-file verification token, served at /<token>.
# GOOGLE_SITE_VERIFICATION=google0123456789abcdef.html
# Old hostnames whose page visits move permanently to PUBLIC_URL (comma-separated).
# REDIRECT_HOSTS=old-name.up.railway.app
# Separate domain for tracking/unsubscribe links in email (hosted). Unset uses PUBLIC_URL.
# LINK_URL=https://links-example.com
# Marketing site on its own host (README: "Marketing site and app on separate hosts"). Unset keeps
# one host: the dashboard at /, the landing page at /home.
# SITE_URL=https://example.com
# Share the session and Google sign-in cookies between the site and app hosts.
# COOKIE_DOMAIN=example.com
# Base of the Google OAuth redirect URI when it isn't PUBLIC_URL (needs COOKIE_DOMAIN across hosts).
# GOOGLE_REDIRECT_BASE=https://example.com
