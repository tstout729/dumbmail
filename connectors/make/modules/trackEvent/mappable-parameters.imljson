[
	{ "name": "metric", "type": "text", "label": "Metric", "required": true, "help": "The event name, e.g. Placed Order or Booked Demo." },
	{ "name": "email", "type": "email", "label": "Email", "help": "Who did it: an email, phone number or external ID." },
	{ "name": "phone_number", "type": "text", "label": "Phone number" },
	{ "name": "external_id", "type": "text", "label": "External ID" },
	{ "name": "value", "type": "number", "label": "Value", "help": "Revenue for orders." },
	{
		"name": "properties",
		"type": "array",
		"label": "Properties",
		"spec": [
			{ "name": "key", "type": "text", "label": "Name", "required": true },
			{ "name": "value", "type": "text", "label": "Value" }
		]
	},
	{ "name": "unique_id", "type": "text", "label": "Unique ID", "help": "Makes retries safe: the same metric and unique ID is recorded once." },
	{ "name": "time", "type": "date", "label": "Time", "help": "When it happened. Defaults to now." }
]
