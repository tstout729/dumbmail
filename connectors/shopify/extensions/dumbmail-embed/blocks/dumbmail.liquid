{%- comment -%}
  DumbMail's website snippet on every page. DumbMail saves the script's address (with the store's
  public key) in this app's settings when the store connects; nothing to type here.

  It loads only once Shopify's Customer Privacy API says the visitor allows analytics. Recognising
  visitors by the email they type (identification) also needs marketing to be allowed; without it
  the snippet loads without recognising anyone. If the visitor gives consent later, it loads then.
  If they withdraw analytics or marketing consent after it was added (even before it has started),
  the snippet's stop() ends all sending from the page and deletes events still waiting to be sent.
  If the Customer Privacy API can't load, the snippet doesn't either.
{%- endcomment -%}
{%- assign dumbmail_src = app.metafields.dumbmail.script_url.value -%}
{%- if dumbmail_src != blank -%}
  <script>
    (function () {
      var src = {{ dumbmail_src | json }};
      var loaded = false;
      // What the snippet reads when it starts (see `dumbmailConsent` in onsite.js), kept current.
      var consent = (window.dumbmailConsent = window.dumbmailConsent || {});
      function stop() {
        consent.withdrawn = true;
        if (window.dumbmail && typeof window.dumbmail.stop === "function") window.dumbmail.stop();
      }
      function load(marketing) {
        if (loaded || consent.withdrawn) return;
        loaded = true;
        var s = document.createElement("script");
        s.async = true;
        s.src = src;
        if (!marketing) s.setAttribute("data-capture-emails", "false");
        document.head.appendChild(s);
      }
      function apply(analytics, marketing) {
        var hadMarketing = consent.marketing;
        consent.analytics = analytics;
        consent.marketing = marketing;
        if (loaded && (!analytics || (hadMarketing && !marketing))) {
          // Withdrawn after the snippet was added (whether or not it has started yet): it stops.
          stop();
        } else if (analytics) {
          load(marketing);
        }
      }
      function check() {
        var p = window.Shopify && window.Shopify.customerPrivacy;
        if (p) apply(!!p.analyticsProcessingAllowed(), !!p.marketingAllowed());
      }
      document.addEventListener("visitorConsentCollected", function (e) {
        var d = (e && e.detail) || {};
        apply(!!d.analyticsAllowed, !!d.marketingAllowed);
      });
      if (window.Shopify && typeof window.Shopify.loadFeatures === "function") {
        window.Shopify.loadFeatures([{ name: "consent-tracking-api", version: "1.0" }], function (error) {
          if (!error) check();
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "DumbMail",
  "target": "head",
  "settings": []
}
{% endschema %}
